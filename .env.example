# Salin jadi .env.local, lalu isi. Berkas .env.local TIDAK ikut git.

# Rahasia penanda tangan tiket masuk. Minimal 32 karakter.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Kalau kosong atau terlalu pendek, gerbang menjawab 503 untuk SEMUA alamat.
# Itu disengaja: halaman yang tidak bisa mengunci lebih baik tidak membuka.
#
# Kalau nilainya diganti, semua tiket yang sudah beredar langsung batal dan
# Olen harus memasukkan PIN lagi. Itu juga cara mencabut akses dari perangkat
# yang hilang.
OLEN_RAHASIA=

# Harus SAMA dengan basePath di next.config.ts. Dipakai kode klien untuk
# menyusun alamat foto dan audio; kalau berbeda, halamannya tetap terbuka
# tapi foto dan suaranya diam-diam 404.
NEXT_PUBLIC_BASE=/len

# Opsional. Bawaannya <cwd>/data/olen.db
# OLEN_DB=
